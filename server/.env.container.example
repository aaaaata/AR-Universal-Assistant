# AR 麻将助手 cloud/ Docker 与流水线配置模板
# 本地 Docker 可复制为 cloud/.env.container.local；该文件不进入 Git。
# 公司流水线应以部署平台环境变量和 secret 注入为准，不提交实际 API Key。

CLOUD_HOST=0.0.0.0
CLOUD_PORT=8080
CLOUD_WORKERS=3

# 当前仅有 local / test 两种运行环境。流水线公网测试服必须显式使用 test。
CLOUD_RUNTIME_ENV=test
# 流水线应覆盖为镜像 tag 或 Git commit；该值会写入证据 ZIP。

CLOUD_SERVICE_VERSION=replace-with-image-tag-or-git-sha
CLOUD_ANALYSIS_CONCURRENCY=1
CLOUD_ANALYSIS_QUEUE_TIMEOUT_MS=200
CLOUD_ANALYSIS_EXEC_TIMEOUT_MS=0

# 本地 Docker 调试时替换为随机值；流水线由 secret 覆盖。
CLOUD_API_KEY=replace-with-an-internal-device-token

# 容器内路径；不要复制到宿主机本地的 .env.local。
CLOUD_REGION_MANIFEST=/app/server/models/region.manifest.json
CLOUD_TILE_MANIFEST=/app/server/models/tile.manifest.json

CLOUD_MAX_UPLOAD_BYTES=10485760
CLOUD_MIN_IMAGE_WIDTH=640
CLOUD_MIN_IMAGE_HEIGHT=360
CLOUD_MAX_IMAGE_PIXELS=8000000

# ROI 裁切外扩。四边同一像素 pad = max(短边 × ratio, px)，允许 0，拒绝负数。
CLOUD_ROI_PADDING_RATIO=0.05
CLOUD_ROI_PADDING_PX=8

CLOUD_DATABASE_PATH=/app/server/data/cloud.db
CLOUD_DEBUG_IMAGE_DIR=/app/server/data/debug_images
CLOUD_EVIDENCE_DIR=/app/server/data/evidence

# S4 运行数据留存。测试服 Profile 默认：成功帧每会话 30 秒最多留 1 张，普通图 3 天/3 GiB，
# SQLite 7 天/512 MiB，证据 14 天/2 GiB，总量 6 GiB，并保留至少 1 GiB 空闲空间。
CLOUD_RETENTION_ENABLED=1
CLOUD_RETENTION_CLEANUP_INTERVAL_MINUTES=30
CLOUD_STORAGE_MAX_BYTES=6442450944
CLOUD_STORAGE_MIN_FREE_BYTES=1073741824
CLOUD_DEBUG_IMAGE_MODE=sampled
CLOUD_DEBUG_IMAGE_SUCCESS_SAMPLE_INTERVAL_SECONDS=30
CLOUD_DEBUG_IMAGE_RETENTION_DAYS=3
CLOUD_DEBUG_IMAGE_MAX_BYTES=3221225472
CLOUD_ANALYSIS_RETENTION_DAYS=7
CLOUD_SQLITE_MAX_BYTES=536870912
CLOUD_PENDING_ANALYSIS_STALE_MINUTES=30
CLOUD_EVIDENCE_ENABLED=1
CLOUD_EVIDENCE_RETENTION_DAYS=14
CLOUD_EVIDENCE_MAX_BYTES=2147483648
CLOUD_EVIDENCE_MAX_PER_SIGNATURE_PER_HOUR=5
CLOUD_EVIDENCE_SLOW_ROUTE_THRESHOLD_MS=5000
CLOUD_DEV_FULL_IMAGE_HAND_REGION=0
YOLO_CONFIG_DIR=/tmp/Ultralytics
