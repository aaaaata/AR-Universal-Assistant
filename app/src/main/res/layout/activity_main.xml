<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/menu_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="26dp"
            android:text="@string/app_name"
            android:textColor="@color/neon_green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="center_vertical">

            <HorizontalScrollView
                android:id="@+id/menu_scene_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/menu_scene_items"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />
            </HorizontalScrollView>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/scene_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/status_ready"
            android:textColor="@color/neon_green"
            android:textSize="22sp" />

        <FrameLayout
            android:id="@+id/scene_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_instruction_idle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_capsule_border"
            android:paddingHorizontal="26dp"
            android:paddingVertical="10dp"
            android:text="@string/instruction_start_scene"
            android:textColor="@color/neon_green"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_instruction_running"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_capsule_border"
            android:paddingHorizontal="19dp"
            android:paddingVertical="10dp"
            android:text="@string/instruction_stop_scene"
            android:textColor="@color/neon_green"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
