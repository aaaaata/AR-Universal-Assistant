# AR 麻将助手 cloud/ 本地配置模板
# 可选：复制为 cloud/.env.local 后按当前机器调整；.env.local 不进入 Git。
# 此文件只用于宿主机本地启动，不要用于 Docker 或流水线容器。

CLOUD_HOST=0.0.0.0
CLOUD_PORT=8000
CLOUD_WORKERS=3

# 仅支持 local 或 test；未知值会拒绝启动。本模板固定为宿主机本地联调。
CLOUD_RUNTIME_ENV=local
CLOUD_SERVICE_VERSION=local

# 分析并发保护。每个 worker 同时只运行一路推理；资源繁忙时短等待后快速拒绝本帧。
CLOUD_ANALYSIS_CONCURRENCY=1
CLOUD_ANALYSIS_QUEUE_TIMEOUT_MS=200
CLOUD_ANALYSIS_EXEC_TIMEOUT_MS=0

# 仅供本地开发联调。生产/流水线由部署平台 secret 注入，不使用此值。
CLOUD_API_KEY=local-token

# 宿主机本地路径，均相对于仓库根目录。默认按 CPU 推理配置加载模型权重。
CLOUD_REGION_MANIFEST=cloud/models/region.manifest.json
CLOUD_TILE_MANIFEST=cloud/models/tile.manifest.json

# 图片输入限制。原图性能实验可在 .env.local 中把 CLOUD_MAX_IMAGE_PIXELS 设为 0。
CLOUD_MAX_UPLOAD_BYTES=10485760
CLOUD_MIN_IMAGE_WIDTH=640
CLOUD_MIN_IMAGE_HEIGHT=360
CLOUD_MAX_IMAGE_PIXELS=8000000

# ROI 裁切外扩。四边同一像素 pad = max(短边 × ratio, px)，允许 0，拒绝负数。
CLOUD_ROI_PADDING_RATIO=0.05
CLOUD_ROI_PADDING_PX=8

# 本地运行数据。
CLOUD_DATABASE_PATH=cloud/data/cloud.db
CLOUD_DEBUG_IMAGE_DIR=cloud/data/debug_images
CLOUD_EVIDENCE_DIR=cloud/data/evidence
CLOUD_SESSION_RECORDING_DIR=cloud/data/session_recordings

# S4 运行数据留存。本地 Profile 默认：普通图全量 1 天/1 GiB，SQLite 3 天/128 MiB，
# 证据 3 天/512 MiB，总量 2 GiB，并保留至少 512 MiB 空闲空间。
CLOUD_RETENTION_ENABLED=1
CLOUD_RETENTION_CLEANUP_INTERVAL_MINUTES=30
CLOUD_STORAGE_MAX_BYTES=2147483648
CLOUD_STORAGE_MIN_FREE_BYTES=536870912
CLOUD_DEBUG_IMAGE_MODE=always
CLOUD_DEBUG_IMAGE_SUCCESS_SAMPLE_INTERVAL_SECONDS=0
CLOUD_DEBUG_IMAGE_RETENTION_DAYS=1
CLOUD_DEBUG_IMAGE_MAX_BYTES=1073741824
CLOUD_ANALYSIS_RETENTION_DAYS=3
CLOUD_SQLITE_MAX_BYTES=134217728
CLOUD_PENDING_ANALYSIS_STALE_MINUTES=30
CLOUD_EVIDENCE_ENABLED=1
CLOUD_EVIDENCE_RETENTION_DAYS=3
CLOUD_EVIDENCE_MAX_BYTES=536870912
CLOUD_EVIDENCE_MAX_PER_SIGNATURE_PER_HOUR=5
CLOUD_EVIDENCE_SLOW_ROUTE_THRESHOLD_MS=0

# 测试服回归录制。regression 模式仍要求 CLOUD_RUNTIME_ENV=test；
# 默认单活跃会话、每会话 8 GiB、结束后保留 1 天。
CLOUD_SESSION_RECORDING_ENABLED=1
CLOUD_SESSION_RECORDING_MAX_BYTES=8589934592
CLOUD_SESSION_RECORDING_RETENTION_DAYS=1
CLOUD_SESSION_RECORDING_MAX_ACTIVE=1

# 开发假区域模型。真实联调必须为 0。
CLOUD_DEV_FULL_IMAGE_HAND_REGION=0

# 避免 Ultralytics 在不可写 HOME 下产生噪声。
YOLO_CONFIG_DIR=/tmp/Ultralytics
