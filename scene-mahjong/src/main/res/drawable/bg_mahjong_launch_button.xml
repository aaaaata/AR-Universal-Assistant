<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="#79A978" />
            <stroke android:width="3dp" android:color="#00FF2A" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#6EA36D" />
            <stroke android:width="1dp" android:color="#6EA36D" />
            <corners android:radius="4dp" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
